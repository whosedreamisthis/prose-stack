generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String?   @unique
  name          String?
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime? // set for demo users: createdAt + 12 h
  theme         Theme? // null until the writer chooses; then the system preference applies
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]

  @@index([isDemo, demoExpiresAt])
}

enum Theme {
  LIGHT
  DARK
}

enum LineSpacing {
  SINGLE
  ONE_AND_HALF
  DOUBLE
}

model Project {
  id       String  @id @default(cuid())
  userId   String
  title    String
  subtitle String?
  author   String

  // Cover: a design + color, or an uploaded image
  coverDesign   String  @default("classic")
  coverColor    String  @default("#1e3a5f")
  coverImageUrl String?

  // Formatting settings
  fontFamily  String      @default("Georgia")
  fontSize    Int         @default(12) // 10–18
  lineSpacing LineSpacing @default(DOUBLE)

  lastOpenedAt DateTime? // drives where sign-in lands
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes           ManuscriptNode[]
  dailyWordCounts DailyWordCount[]
  characters      Character[]
  places          Place[]
  plotLines       PlotLine[]
  notes           ProjectNote[]

  @@index([userId])
}

enum ManuscriptNodeType {
  PART
  CHAPTER
  SCENE
}

/// The manuscript tree. The project is the implicit book root; parentId is null for top-level parts and chapters.
model ManuscriptNode {
  id        String             @id @default(cuid())
  projectId String
  parentId  String?
  type      ManuscriptNodeType
  title     String
  position  Int // order among siblings, 0-based
  content   Json? // scenes only: Tiptap document
  summary   String? // scenes only
  wordCount Int                @default(0) // scenes only
  labelId   String? // scenes only; labels arrive with the scene sidebar
  trashedAt DateTime? // set on a trashed node and all of its descendants together
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     ManuscriptNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   ManuscriptNode[] @relation("NodeChildren")
  notes      SceneNote[]
  plotPoints PlotPoint[]

  @@index([projectId, parentId, position])
}

/// Free-form notes shown in the right sidebar; a scene can have several.
model SceneNote {
  id        String    @id @default(cuid())
  sceneId   String
  title     String?
  content   String
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  scene ManuscriptNode @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, createdAt])
}

/// Total words in the project at the start of each day the writer saved; words today = current total minus startWords.
model DailyWordCount {
  id         String   @id @default(cuid())
  projectId  String
  date       DateTime @db.Date
  startWords Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
}

enum CharacterRole {
  MAIN
  SUPPORTING
}

/// A character sketch. Every sketch field is optional text except the name. A character is hidden from the list once trashed or archived.
model Character {
  id        String        @id @default(cuid())
  projectId String
  role      CharacterRole @default(MAIN)
  name      String
  age       String?
  location  String?

  roleInStory         String?
  goal                String?
  physicalDescription String?
  personality         String?
  occupation          String?
  habits              String?
  background          String?
  internalConflicts   String?
  externalConflicts   String?

  trashedAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes   CharacterNote[]
  places  Place[]         @relation("PlaceCharacters")

  @@index([projectId, role])
}

/// Free-form notes shown in the right sidebar; a character can have several.
model CharacterNote {
  id          String    @id @default(cuid())
  characterId String
  title       String?
  content     String
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
}

/// A place card for a setting of the novel. Every field is optional text except the name. Hidden from the list once trashed or archived.
model Place {
  id        String @id @default(cuid())
  projectId String
  name      String

  location       String?
  roleInStory    String?
  season         String?
  uniqueFeatures String?
  description    String?
  sights         String?
  sounds         String?
  smell          String?

  trashedAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relatedCharacters Character[] @relation("PlaceCharacters")
  notes             PlaceNote[]

  @@index([projectId, createdAt])
}

/// Free-form notes shown in the right sidebar; a place can have several.
model PlaceNote {
  id        String    @id @default(cuid())
  placeId   String
  title     String?
  content   String
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, createdAt])
}

/// A plot line: one column of the plot grid. Trashing it hides its points with it; they come back on restore.
model PlotLine {
  id        String    @id @default(cuid())
  projectId String
  name      String
  position  Int // order among the project's live lines, 0-based
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points  PlotPoint[]

  @@index([projectId, position])
}

/// A plot point: the cell where a scene's row meets a plot line, so it always belongs to a scene. A trashed scene hides its points (reads filter on the scene), and deleting the scene deletes them.
model PlotPoint {
  id         String    @id @default(cuid())
  plotLineId String
  sceneId    String
  title      String?
  text       String
  trashedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  plotLine PlotLine       @relation(fields: [plotLineId], references: [id], onDelete: Cascade)
  scene    ManuscriptNode @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([plotLineId, sceneId])
  @@index([sceneId])
}

/// Free-form notes shown in the right sidebar when the whole manuscript is open; a project can have several.
model ProjectNote {
  id        String    @id @default(cuid())
  projectId String
  title     String?
  content   String
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
