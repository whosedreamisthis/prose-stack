generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String?   @unique
  name          String?
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime? // set for demo users: createdAt + 12 h
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]

  @@index([isDemo, demoExpiresAt])
}

enum Theme {
  LIGHT
  DARK
}

enum LineSpacing {
  SINGLE
  ONE_AND_HALF
  DOUBLE
}

model Project {
  id       String  @id @default(cuid())
  userId   String
  title    String
  subtitle String?
  author   String

  // Cover: a design + color, or an uploaded image
  coverDesign   String  @default("classic")
  coverColor    String  @default("#1e3a5f")
  coverImageUrl String?

  // Formatting settings
  fontFamily  String      @default("Georgia")
  fontSize    Int         @default(12) // 10–18
  lineSpacing LineSpacing @default(DOUBLE)
  theme       Theme       @default(LIGHT)

  lastOpenedAt DateTime? // drives where sign-in lands
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
